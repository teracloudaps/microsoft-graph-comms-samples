<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Required for VM hosting. These may also be supplied as environment variables with the same key or POLICY_RECORDING_BOT_ prefix. -->
    <add key="ServiceDnsName" value="%ServiceDnsName%" />
    <add key="AadAppId" value="%AadAppId%" />
    <add key="AadAppSecret" value="%AadAppSecret%" />
    <add key="DefaultCertificate" value="%CertificateThumbprint%" />

    <!-- Optional VM hosting settings. -->
    <add key="PlaceCallEndpointUrl" value="https://graph.microsoft.com/v1.0" />
    <add key="CallControlPort" value="9442" />
    <add key="MediaPort" value="8445" />
    <add key="InstancePublicIPAddress" value="" />
    <add key="CallControlHost" value="" />
    <add key="ServiceFqdn" value="" />
    <add key="HomeTenantId" value="" />
  </appSettings>
</configuration>